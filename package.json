{
  "name": "@d13co/dt-algokit-utils",
  "version": "9.2.3-dt.5.2.0.0",
  "private": false,
  "description": "Fork of @algorandfoundation/algokit-utils with dtalgod support: reads at past rounds, object versions and history, asset holders, extended simulate and read-only TEAL queries.",
  "keywords": [
    "algorand",
    "algokit",
    "dtalgod",
    "time-travel",
    "simulate",
    "query",
    "history",
    "holders"
  ],
  "author": "Bit D13 <bit@d13.co>",
  "contributors": [
    "Algorand Foundation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d13co/dt-algokit-utils-ts.git"
  },
  "homepage": "https://github.com/d13co/dt-algokit-utils-ts#readme",
  "bugs": {
    "url": "https://github.com/d13co/dt-algokit-utils-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.0"
  },
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "**/*"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./types/*": {
      "types": "./types/*.d.ts",
      "import": "./types/*.mjs",
      "require": "./types/*.js"
    },
    "./testing": {
      "types": "./testing/index.d.ts",
      "import": "./testing/index.mjs",
      "require": "./testing/index.js"
    },
    "./index.d.ts": "./index.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:0-clean": "rimraf dist coverage",
    "build:1-compile": "rolldown -c",
    "build:2-emit-types": "tsc --project tsconfig.build.json --emitDeclarationOnly --rootDir src --outDir dist",
    "build:3-copy-pkg-json": "tsx scripts/copy-package-json.ts",
    "build:4-copy-readme": "cpy README.md LICENSE dist",
    "build:5-fix-readme-links": "replace-in-files --string '(./' --replacement '(https://github.com/d13co/dt-algokit-utils-ts/blob/dtalgorand/' dist/README.md",
    "build:6-check-dist-types": "tsc --project tsconfig.dist-check.json",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest watch --coverage --passWithNoTests",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "check-types": "tsc --project tsconfig.typecheck.json --noEmit",
    "audit": "better-npm-audit audit",
    "format": "prettier --write .",
    "commit-lint": "commitlint --edit -o",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:preview": "pnpm --dir docs run preview",
    "pre-commit": "run-s check-types lint:fix audit format test",
    "prepublishOnly": "echo 'Publish the build, not the repo root: npm run build && npm publish ./dist' && exit 1"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "cross-spawn": ">=7.0.5",
    "brace-expansion": ">=5.0.12",
    "picomatch": ">=4.0.2",
    "fast-uri": ">=4.1.5",
    "postcss": ">=8.5.23"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "algosdk": "^3.5.2 || ^3.9.0-dt.5.2.0.0"
  },
  "devDependencies": {
    "@algorandfoundation/tealscript": "^0.106.3",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.15.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/json-bigint": "^1.0.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@vitest/coverage-v8": "^4.1.11",
    "algosdk": "npm:dt-algosdk@3.9.0-dt.5.2.0.0",
    "better-npm-audit": "^3.11.0",
    "cpy-cli": "^5.0.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "fast-glob": "^3.3.2",
    "magic-string": "^0.30.11",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "replace-in-files-cli": "^3.0.0",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.0-rc.12",
    "tiny-invariant": "^1.3.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.16.0",
    "uuid": "^14.0.0",
    "vitest": "^4.1.11",
    "vitest-fetch-mock": "^0.4.5"
  }
}
